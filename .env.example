# URL de la API pública de la app (solo lectura). Se consulta al hacer build.
PUBLIC_API_URL=https://cancha.arianedevs.com/api/v1
# URL de la app de reservas (destino de los botones "Reservar").
PUBLIC_APP_URL=https://cancha.arianedevs.com
# WhatsApp de contacto en formato internacional sin "+" (ej: 573001234567). Vacío = se oculta el botón.
PUBLIC_WHATSAPP=
# Google Analytics 4 (ej: G-ABC123XYZ). Vacío = sin analítica.
PUBLIC_GA4_ID=
# Slugs de clubes a ocultar en la landing, separados por coma (ej: clubes de prueba).
HIDDEN_CLUBS=
