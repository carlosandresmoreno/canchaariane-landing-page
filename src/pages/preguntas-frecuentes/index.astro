---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getClubs } from '../../lib/clubs';
import { buildFaqs } from '../../lib/faqs';
import { SITE } from '../../lib/config';
import { faqSchema, webPageSchema } from '../../lib/schema';

const faqs = buildFaqs(await getClubs());
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Preguntas frecuentes', path: '/preguntas-frecuentes/' },
];
const title = `Preguntas Frecuentes: Canchas en ${SITE.defaultCity}`;
const description = `Precios, horarios, pagos y cancelaciones: todo lo que necesitas saber para alquilar una cancha sintética en ${SITE.defaultCity} con Canchariane.`;
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={crumbs}
  schema={[webPageSchema({ path: '/preguntas-frecuentes/', name: title, description }), faqSchema(faqs)]}
>
  <section class="relative isolate overflow-hidden border-b border-line">
    <div class="pitch-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto max-w-4xl px-4 pt-8 pb-14 sm:px-6 lg:pt-12">
      <Breadcrumbs items={crumbs} />
      <h1 class="display mt-8 text-[clamp(2.3rem,9vw,4.75rem)]">Preguntas <span class="mark-pitch">frecuentes</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Todo sobre cómo alquilar una cancha sintética en {SITE.defaultCity}: precios, pagos, horarios y cancelaciones.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20" aria-label="Preguntas y respuestas">
    <FaqList faqs={faqs} headingLevel="h2" />
  </section>
  <CtaBand campaign="faq" />
</BaseLayout>
