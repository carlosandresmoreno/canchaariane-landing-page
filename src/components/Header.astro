---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { appLink } from '../lib/config';

const path = Astro.url.pathname;
const nav = [
  { href: '/canchas/', label: 'Canchas' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/preguntas-frecuentes/', label: 'Preguntas' },
  { href: '/para-clubes/', label: 'Para clubes' },
];
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-white/85 backdrop-blur-xl supports-[backdrop-filter]:bg-white/75">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" aria-label="Canchariane, ir al inicio" class="-m-2 rounded-xl p-2">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="rounded-full px-4 py-2 text-sm font-semibold text-ink-soft transition hover:bg-mist hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-white"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={appLink('/', { campaign: 'header' })} class="btn btn-primary hidden !min-h-11 !px-5 text-sm sm:inline-flex">
        Reservar <Icon name="arrow" class="size-4" />
      </a>

      <!-- Menú móvil sin JavaScript: <details> nativo -->
      <details class="group relative md:hidden" data-mobile-menu>
        <summary
          class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-white [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú"
        >
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="close" class="hidden size-5 group-open:block" />
        </summary>
        <div class="fixed inset-x-3 top-[4.5rem] rounded-3xl border border-line bg-white p-3 shadow-2xl shadow-ink/10">
          <ul class="grid gap-1">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="flex min-h-12 items-center justify-between rounded-2xl px-4 text-base font-semibold hover:bg-mist">
                  {item.label} <Icon name="arrow" class="size-4 text-muted" />
                </a>
              </li>
            ))}
          </ul>
          <a href={appLink('/', { campaign: 'menu' })} class="btn btn-primary mt-2 w-full">
            Reservar cancha <Icon name="arrow" class="size-4" />
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra el menú móvil al navegar a un ancla o tocar fuera.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
