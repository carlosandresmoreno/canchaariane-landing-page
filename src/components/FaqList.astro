---
/** Preguntas frecuentes visibles (acordeón nativo). Deben coincidir 1:1 con el JSON-LD FAQPage. */
import Icon from './Icon.astro';
interface Props { faqs: { q: string; a: string }[]; headingLevel?: 'h2' | 'h3'; openFirst?: boolean }
const { faqs, headingLevel: H = 'h3', openFirst = true } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {faqs.map((f, i) => (
    <details class="group" open={openFirst && i === 0}>
      <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
        <H class="text-base font-bold text-ink sm:text-lg">{f.q}</H>
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-mist text-ink transition group-open:rotate-45 group-open:bg-pitch">
          <Icon name="plus" class="size-4" />
        </span>
      </summary>
      <p class="max-w-3xl pb-6 leading-relaxed text-ink-soft">{f.a}</p>
    </details>
  ))}
</div>
